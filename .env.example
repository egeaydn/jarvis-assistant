GEMINI_API_KEY=buraya_gemini_api_keyini_yaz
GROQ_API_KEY=gsk_senin_groq_keyin

# Wake Word — isteğe bağlı Porcupine (https://console.picovoice.ai)
# Yapılandırılmazsa Google STT + yerel doğrulama kullanılır.
PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=

# Wake word için Google STT dili. Varsayılan: tr-TR
WAKE_STT_LANGUAGE=tr-TR

# STT'nin sık ürettiği alternatif ifadeler (virgülle ayırın).
# Bu ifadeler tam eşleştiğinde tetikler; örnek: hey yarvis,hair dryers
WAKE_WORD_ALIASES=
